[Defines]
  INF_VERSION    = 0x0001001B
  BASE_NAME      = Vesper
  FILE_GUID      = 4B8E2C71-9A16-4F3D-B7C0-1E5A8D93F024
  MODULE_TYPE    = DXE_RUNTIME_DRIVER
  VERSION_STRING = 0.1
  ENTRY_POINT    = ei_entry

[Sources]
  core/main.c
  core/handoff.c
  core/notify.c
  core/svc.c
  mem/phys.c
  mem/vtop.c
  mem/image.c
  mem/scan.c
  fw/nv.c
  fw/fv.c
  fw/leaf.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiRuntimeLib
  UefiLib
  PcdLib
  BaseMemoryLib
  MemoryAllocationLib

[Protocols]
  gEfiSmmCommunicationProtocolGuid

[Guids]
  gEfiEventVirtualAddressChangeGuid

[Depex]
  gEfiCpuArchProtocolGuid

[BuildOptions]
  MSFT:*_*_*_CC_FLAGS = /I$(MODULE_DIR)/inc /I$(MODULE_DIR)/../deps/types /I$(MODULE_DIR)/../ext/pe /WX-
  MSFT:*_*_*_DLINK_FLAGS = /SUBSYSTEM:EFI_RUNTIME_DRIVER
